<?xml version="1.0" encoding="UTF-8"?>
<!--
  专用于阅读 / 编译 spring-ai 官方仓（含 Spring Boot SNAPSHOT）的 Maven settings。

  用法（PowerShell）：
    $env:JAVA_HOME="D:\Java\jdk-21.0.4"
    mvn -s maven-settings-spring-ai.xml -U ...

  IDEA：Settings → Maven → User settings file 指向本文件（打开 spring-ai 工程时）。

  说明：
  - 保留阿里云镜像加速，但排除 Spring / Central 的 snapshot 仓库，避免 mirrorOf=* 劫持。
  - localRepository 与本机全局配置保持一致（D:/Java/mvn_repo）；若你不用该路径，请改掉。
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0
          https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <localRepository>D:/Java/mvn_repo</localRepository>

  <mirrors>
    <mirror>
      <id>aliyunmaven</id>
      <name>Aliyun Maven (excluding Spring snapshots)</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>*,!spring-snapshots,!spring-milestones,!central-portal-snapshots,!spring-enterprise-snapshot,!spring-enterprise-release</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>spring-ai-snapshots</id>
      <repositories>
        <repository>
          <id>central-portal-snapshots</id>
          <name>Central Portal Snapshots</name>
          <url>https://central.sonatype.com/repository/maven-snapshots/</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>spring-snapshots</id>
          <name>Spring Snapshots</name>
          <url>https://repo.spring.io/snapshot</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>spring-milestones</id>
          <name>Spring Milestones</name>
          <url>https://repo.spring.io/milestone</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>spring-snapshots</id>
          <url>https://repo.spring.io/snapshot</url>
          <releases>
            <enabled>false</enabled>
          </releases>
          <snapshots>
            <enabled>true</enabled>
          </snapshots>
        </pluginRepository>
        <pluginRepository>
          <id>spring-milestones</id>
          <url>https://repo.spring.io/milestone</url>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>spring-ai-snapshots</activeProfile>
  </activeProfiles>
</settings>
