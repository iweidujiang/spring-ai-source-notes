<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.iweidujiang</groupId>
    <artifactId>spring-ai-source-notes</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Spring AI Source Notes</name>
    <description>Spring AI 源码阅读笔记与可运行样例（配套博文）</description>
    <url>https://github.com/iweidujiang/spring-ai-source-notes</url>
    <inceptionYear>2026</inceptionYear>

    <developers>
        <developer>
            <id>iweidujiang</id>
            <name>苏渡苇</name>
            <url>https://github.com/iweidujiang</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/iweidujiang/spring-ai-source-notes.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/iweidujiang/spring-ai-source-notes.git</developerConnection>
        <url>https://github.com/iweidujiang/spring-ai-source-notes</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 默认用 Ollama，本地可读源码、开源读者无需云厂商 Key -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 可选：改用 OpenAI 兼容端点（含云厂商兼容 API） -->
        <profile>
            <id>openai</id>
            <dependencies>
                <dependency>
                    <groupId>org.springframework.ai</groupId>
                    <artifactId>spring-ai-starter-model-openai</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
